# ── 배포 모드 ────────────────────────────────────────────────
# false: docker-compose로 InfluxDB + Grafana + collector 함께 실행 (기본)
# true : 기존에 운영 중인 InfluxDB/Grafana를 사용, collector만 실행
USE_EXISTING_SERVICES=false

# 내장 모드(USE_EXISTING_SERVICES=false)에서 embedded 프로필 활성화
# 기존 서비스 사용 모드에서는 비워 두세요 (COMPOSE_PROFILES=)
COMPOSE_PROFILES=embedded

# ── InfluxDB ─────────────────────────────────────────────────
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORG=stockdashboard
INFLUXDB_BUCKET=macro_indicators
INFLUXDB_TOKEN=

# 호스트/포트 (기존 서비스 사용 모드에서 collector가 접속할 주소)
# Docker Desktop(Mac/Win): INFLUXDB_HOST=host.docker.internal
# Linux: INFLUXDB_HOST=172.17.0.1 또는 실제 호스트 IP
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
# INFLUXDB_URL=http://host.docker.internal:8086  # URL을 직접 지정하면 HOST/PORT보다 우선

# ── Grafana ──────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# 기존 Grafana UI 접속 주소 (참고/문서용, collector는 사용하지 않음)
GRAFANA_HOST=localhost
GRAFANA_PORT=3000

# (선택) FRED API 키 - https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료 발급
# 없어도 동작하지만 있으면 데이터 정확도 향상
FRED_API_KEY=

# ── 데이터 수집 스케줄 (collector 컨테이너) ───────────────────
# 시작 시 1회 수집 후, 매일 COLLECT_DAILY_AT 시각에 자동 갱신
TZ=Asia/Seoul
COLLECT_DAILY_AT=09:00
